    "parameters": {
     "jsCode": "const resultados = $json.resultados || [];\nlet texto;\nif (resultados.length === 0) {\n  texto = 'TED - Nao encontrei nada indexado sobre isso no catalogo do cluster.';\n} else {\n  const melhor = resultados[0];\n  texto = 'TED - Encontrei isto (fonte: ' + melhor.fonte + '):\\n\\n' + melhor.trecho;\n}\nreturn [{ json: { texto } }];"
