   },
   {
    "id": "n6a_formata",
    "name": "6a. Formata Resultado da Auditoria",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1100,
     260
    ],
    "parameters": {
     "jsCode": "const d = $json;\nconst achados = d.achados || [];\nlet texto;\nif (achados.length === 0) {\n  texto = 'TED - Auditoria de infraestrutura: cluster 100% saudavel, nenhum achado.';\n} else {\n  const linhas = achados.map((a, i) => {\n    const acao = (d.acoes || [])[i] || {};\n    const consenso = acao.consenso || {};\n    const status = consenso.consenso ? ('corrigido automaticamente: ' + (acao.resultado_acao || '')) : 'sinalizado, sem autofix';\n    return '- ' + (a.tipo || 'achado') + ' (' + (a.agente || '?') + '): ' + status;\n  });\n  texto = 'TED - Auditoria de infraestrutura encontrou ' + achados.length + ' item(ns):\\n' + linhas.join('\\n');\n}\nreturn [{ json: { texto } }];"
    }
   },
