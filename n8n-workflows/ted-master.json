   {
    "id": "n2_classifica",
    "name": "2. Classificar Dominio (IA rapida)",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.2,
    "position": [
     220,
     500
    ],
    "parameters": {
     "url": "http://100.112.109.38:8010/ted/router",
     "method": "POST",
     "options": {
      "timeout": 60000
     },
     "sendBody": true,
     "specifyBody": "keypair",
     "bodyParameters": {
      "parameters": [
       {
        "name": "prompt",
        "value": "=Classifique a mensagem abaixo em UM dominio. Responda com UMA UNICA PALAVRA, nada mais, escolhendo entre: INFRA, DOCUMENTOS, CRIAR_AGENTE, CONVERSA.\n\nINFRA = perguntas sobre saude/status/erro do proprio cluster TED (ex: 'o OP2 esta funcionando?', 'como esta o cluster', 'tem algum agente caido')\nDOCUMENTOS = perguntas sobre o que ja foi decidido/documentado/construido no ecossistema TED (ex: 'o que e o P1', 'quais agentes existem', 'como funciona o backup')\nCRIAR_AGENTE = pedido explicito de criar/construir um agente ou automacao nova (ex: 'cria um agente que le meu email')\nCONVERSA = qualquer outra coisa (conversa geral, pergunta fora do TED, pedido de ajuda generico)\n\nExemplo: 'o router esta respondendo?' -> INFRA\nExemplo: 'quantos agentes o TED tem hoje?' -> DOCUMENTOS\nExemplo: 'monta um agente de leitura facial' -> CRIAR_AGENTE\nExemplo: 'bom dia, tudo bem?' -> CONVERSA\n\nMensagem: {{ $json.body.mensagem }}\n\nResposta (uma palavra so):"
       },
       {
        "name": "task_type",
        "value": "fast"
       }
      ]
     }
    }
   },
   {
    "id": "n3_extrai",
    "name": "3. Extrai Classificacao",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     440,
     500
    ],
    "parameters": {
     "jsCode": "const resp = ($json.resposta || '').trim().toUpperCase();\nlet dominio = 'CONVERSA';\nif (resp.includes('INFRA')) dominio = 'INFRA';\nelse if (resp.includes('DOCUMENTOS')) dominio = 'DOCUMENTOS';\nelse if (resp.includes('CRIAR')) dominio = 'CRIAR_AGENTE';\nreturn [{ json: { dominio } }];"
    }
   },
   {
    "id": "n4_if_infra",
    "name": "4. E Pedido de Infra?",
    "type": "n8n-nodes-base.if",
    "typeVersion": 2,
    "position": [
     660,
     500
    ],
    "parameters": {
     "conditions": {
      "options": {
       "caseSensitive": true,
       "typeValidation": "loose"
      },
      "conditions": [
       {
        "leftValue": "={{ $json.dominio }}",
        "rightValue": "INFRA",
        "operator": {
         "type": "string",
         "operation": "contains"
        }
       }
      ],
      "combinator": "and"
     }
    }
   },
   {
    "id": "n5a_auditor",
    "name": "5a. Roda Auditoria do Cluster",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.2,
    "position": [
     880,
     260
    ],
    "parameters": {
     "url": "http://100.112.109.38:8014/ted/auditor/run",
     "method": "POST",
     "options": {
      "timeout": 90000
     },
     "sendBody": true,
     "specifyBody": "keypair",
     "bodyParameters": {
      "parameters": []
     }
